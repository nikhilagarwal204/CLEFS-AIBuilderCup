# Clefs API environment. Copy to .env (never commit .env) and fill in.
# Every variable clefs/settings.py knows is listed here; blank = unset/default.
#
# Comments sit on their own line ABOVE each key, never after an empty value:
# python-dotenv reads `KEY=   # note` as the value "# note", which would turn
# a blank secret into a public, well-known string.
#
# Local development:
#   createdb clefs_dev && DATABASE_URL=postgresql://localhost/clefs_dev python -m clefs.migrate up
# IMPORTANT: DATABASE_URL wins over the legacy PSQL_DATABASE_URL. Keep a
# production URL out of local .env files; export DATABASE_URL for local work.

# ─── Core ───
# development | test | preview | production. Unset means production on a
# Vercel production deploy (VERCEL_ENV), preview on other Vercel deploys, and
# development elsewhere. An unset ENV in a container or on a hosting platform
# is never treated as development, so deployed images must set it. Only
# development/test may run with the dev SECRET_KEY.
ENV=development
# 32+ random chars outside development (tickets, QR keys, button refs, PII keys).
SECRET_KEY=
# Web origins allowed to send cookie-authenticated mutations (CSRF).
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Absolute API origin (webhook URLs, docs).
PUBLIC_API_ORIGIN=http://localhost:8000
# Default: WEB_ORIGINS + https://www.clefs.world,https://clefs.world
CORS_ALLOWED_ORIGINS=
# e.g. ^https://clefs-[a-z0-9-]+\.vercel\.app$ for previews
CORS_ALLOW_ORIGIN_REGEX=
# Secure cookies over HTTPS. Defaults to true for every process that is not
# development (ENV unset in a container or on a hosting platform is not
# development); production refuses to start with it false.
COOKIE_SECURE=false
# Read the caller's IP from X-Real-IP / X-Forwarded-For. Default: true on
# Vercel (which overwrites both), false elsewhere, where uvicorn's
# --proxy-headers / --forwarded-allow-ips resolve the client address instead.
TRUST_FORWARDED_FOR=false
SESSION_TTL_DAYS=30
LOG_LEVEL=INFO
# Comma list, the production kill switch, e.g. demand,reviews
CLEFS_DISABLED_MODULES=
# Comma list: load only these modules (module test runs).
CLEFS_ONLY_MODULES=
# CLEFS_DOTENV=0 in the process environment skips reading .env (the test harness does this).

# ─── Database ───
# Neon: the POOLED endpoint.
DATABASE_URL=postgresql://localhost/clefs_dev
# Neon: the direct endpoint (migrations, LISTEN, advisory locks). Used only
# when it names the same database as the effective DATABASE_URL, and ignored
# when DATABASE_URL was exported in the shell but this one came from .env.
DATABASE_URL_UNPOOLED=
# Legacy name, used only when DATABASE_URL is unset.
PSQL_DATABASE_URL=
# A REMOTE URL read from this file is refused unless the shell exports
# CLEFS_ALLOW_DOTENV_REMOTE_DB=1 (so a stray local command can never reach
# production). Exported variables and deployed environments are unaffected.
# Legacy fallback parts (only when both URLs are unset).
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# 3 on Vercel, 10 per uvicorn worker on a VM.
DB_POOL_MAX=10
# Defaults to true on Vercel (no release step there).
MIGRATE_ON_STARTUP=false

# ─── Runtime ───
# notify (Postgres LISTEN/NOTIFY) | local (in-process; the Vercel default)
EVENTS_BACKEND=notify
# Bearer for /internal/cron/tick (Vercel Cron sends it automatically).
CRON_SECRET=
# Bearer for worker-only internal routes.
WORKER_TOKEN=
VOICE_ENABLED=false

# ─── AI (Google Gemini) ───
# Gemini Developer API key (Google AI Studio). Leave empty on Cloud Run when
# using Vertex AI below.
GEMINI_API_KEY=
# Vertex AI instead of an API key: Cloud Run's service account calls Gemini
# (grant it roles/aiplatform.user).
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Incoming-call webhook signature (HMAC-SHA256) for the voice call bridge.
VOICE_WEBHOOK_SECRET=
# Default: true when GEMINI_API_KEY is set or Vertex AI is on.
AI_ENABLED=
AI_MODEL_DEFAULT=gemini-3.8-flash
AI_MODEL_FAST=gemini-3.1-flash-lite
# Per-task override, e.g. AI_MODEL_INGEST_MAPPING=
# AI_MODEL_<TASK>=
# Thinking budget for every model (tokens; -1 = dynamic). Default: low on
# Gemini 3.x, off on 2.5 Flash/Flash-Lite.
# AI_THINKING_BUDGET=
# Price override for cost_micros, USD per 1M tokens: "in,out" or "in,cached_in,out".
# AI_PRICE_<MODEL>=in,cached_in,out
# Never log prompts/outputs unless debugging.
AI_LOG_CONTENT=false
# Gemini Live API model (guest voice concierge and phone lines).
REALTIME_MODEL=gemini-2.5-flash-native-audio-preview-09-2025
# In-room phone models, read through env() by voice/calls.py. A line's own
# model wins, then VOICE_REALTIME_MODEL, then REALTIME_MODEL.
# VOICE_REALTIME_MODEL=
# Trust: AI eval spend cap, USD per hotel per day (default 5).
# TRUST_EVAL_DAILY_CAP_USD=5
PERPLEXITY_API_KEY=
SERPAPI_KEY=
# USD per SerpApi search, for the serpapi_calls ledger (the Developer plan's $75 / 5,000).
SERPAPI_COST_PER_SEARCH_USD=0.015
# Places API (IDs-only search is the free SKU).
GOOGLE_MAPS_API_KEY=
# Reviews: Tripadvisor Content API key (the tripadvisor source is off without it).
TRIPADVISOR_API_KEY=

# ─── WhatsApp / Meta ───
WA_ACCESS_TOKEN=
# X-Hub-Signature-256 verification.
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_PLATFORM_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_API_VERSION=v23.0
# Lead Ads (leadgen) webhooks.
META_APP_SECRET=
# Approved authentication template for magic links (default clefs_magic_link).
WA_MAGIC_LINK_TEMPLATE=
# Lead Ads (leadgen) webhook hub.verify_token.
META_LEADGEN_VERIFY_TOKEN=
# Free service/utility WhatsApp messages per business number per month.
WA_SERVICE_FREE_ALLOWANCE=0

# ─── Privacy ───
# Outside development these must be set; development derives them from SECRET_KEY.
# Pepper for hashed guest phone/email identities.
CONTACT_HMAC_PEPPER=
# 32 bytes, base64 or hex (AES-256-GCM for sealed PII).
PII_ENC_KEY=
# OTA relay domains never marketed to (comma list, Canon 19).
OTA_ALIAS_DOMAINS=guest.booking.com,m.expediapartnercentral.com

# ─── Notifications ───
# live | log | capture
NOTIFY_MODE=log
# Email goes through Resend both ways. A full-access key: it sends mail and
# reads received mail back (the inbound webhook carries metadata only).
RESEND_API_KEY=
EMAIL_FROM=
# Where replies go when a message names no Reply-To (blank: the From address).
EMAIL_REPLY_TO=
# Domain of <alias>+<purpose>[-<ref>]@<domain> inbound addresses (default in.clefs.world).
INBOUND_EMAIL_DOMAIN=in.clefs.world
INBOUND_EMAIL_ENABLED=false
# Signing secret (whsec_...) of the Resend webhook that sends email.received
# to /webhooks/email/resend.
RESEND_WEBHOOK_SECRET=
# Whose sender verdicts count (auto-commit of mailed imports, forwarded
# reviews). A sender can write their own Authentication-Results, so only a
# verdict naming one of these verifiers counts, and only when exactly one
# copy does. The inbound converter writes them from Resend's API under
# inbound.resend.com, the default for both:
# INBOUND_EMAIL_SPF_VERIFIERS=inbound.resend.com
# INBOUND_EMAIL_AUTHSERV_IDS=inbound.resend.com
# msg91 (legacy India) | twilio (UAE)
SMS_PROVIDER=msg91
SMS_ENABLED=false
SMS_AUTH_KEY=
SMS_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ─── Files ───
# db (Postgres bytea) | s3
FILE_STORE=db
# 25 MB for local and VM runs. On Vercel set 4000000: the platform rejects
# any request body over 4.5 MB (413 FUNCTION_PAYLOAD_TOO_LARGE) before
# FastAPI runs, so a lower cap makes the API refuse early with a clear error.
FILE_MAX_BYTES=26214400
S3_BUCKET=
S3_REGION=

# ─── Demand, visibility, marketing data ───
PREDICTHQ_TOKEN=
RATE_SHOP_PROVIDER=
RATE_SHOP_API_KEY=
GBP_OAUTH_CLIENT_ID=
GBP_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_LEAD_KEY=
# CrUX and PageSpeed Insights.
GOOGLE_API_KEY=
# Absolute origin for OAuth callbacks (default PUBLIC_API_ORIGIN). Must be on
# the web origin, e.g. https://www.clefs.world/api/clefs: the callback checks
# the browser's session cookie. Register
# <this>/public/oauth/<provider>/callback with Google, Xero, Intuit and Zoho.
OAUTH_REDIRECT_BASE=
# Global SerpApi month budget in USD (blank = none) and the public_check cap
# in billed searches per month (blank = 300, 0 = off).
SERPAPI_MONTHLY_BUDGET_USD=
PUBLIC_SERPAPI_MONTHLY_CAP=
# Visibility AI kill switch, Perplexity model, and the Canon 20 legal gate.
VISIBILITY_AI_ENABLED=true
PERPLEXITY_MODEL=sonar
PERPLEXITY_TERMS_APPROVED=false
# Public checks and AI snapshots per day, and the snapshot month budget in USD.
PUBLIC_CHECK_DAILY_CAP=20
SNAPSHOT_DAILY_CAP=10
SNAPSHOT_MONTHLY_BUDGET_USD=50
# Google Business Profile API quota of Clefs' Cloud project, per minute
# (0 = not approved yet, 300 = approved).
GBP_PROJECT_QPM=0
# Demand sources: Ticketmaster Discovery, the commercial Open-Meteo key (blank =
# free non-commercial endpoint), MakCorps rates, and the unofficial Xotelo feed.
TICKETMASTER_API_KEY=
OPEN_METEO_API_KEY=
MAKCORPS_API_KEY=
DEMAND_XOTELO_ENABLED=false

# ─── Public lead magnets ───
# Founder alerts for new leads (blank = none) and the Meta-approved WhatsApp
# follow-up templates (Google check; OTA audit with params [hotel, range, findings]).
FOUNDER_NOTIFY_EMAIL=
FOUNDER_NOTIFY_WHATSAPP=
VIS_LEAD_WA_TEMPLATE=clefs_google_check_followup
PG_AUDIT_LEAD_WA_TEMPLATE=clefs_audit_lead

# ─── Web Push (staff devices) ───
# VAPID keys; push stays log-only without the private key, the subject
# (mailto: or https:) and the optional pywebpush package.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ─── Finance integrations ───
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# sandbox | production (any other value fails at startup)
QBO_ENV=sandbox
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# ─── Payment links (Inquiry Guard) ───
# none | ngenius | telr | stripe | tap
PAYMENT_PROVIDER=none
NGENIUS_API_KEY=
NGENIUS_OUTLET_REF=
NGENIUS_BASE_URL=https://api-gateway.sandbox.ngenius-payments.com
NGENIUS_WEBHOOK_SECRET=
TELR_STORE_ID=
TELR_AUTH_KEY=
TELR_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
TAP_SECRET_KEY=
TAP_PUBLISHABLE_KEY=
TAP_WEBHOOK_SECRET=
# API bases, overridable so sandbox tests can hit a stub.
TELR_API_BASE=https://secure.telr.com
STRIPE_API_BASE=https://api.stripe.com
TAP_API_BASE=https://api.tap.company

# ─── Client (set on the Next app, listed here for reference) ───
# Server-only; target of the /api/clefs rewrite.
# CLEFS_API_ORIGIN=http://localhost:8000
# Direct origin for SSE, uploads and the webhook URLs shown in settings.
# REQUIRED on a deployed web project: the browser code falls back to
# http://localhost:8000, never to CLEFS_API_ORIGIN (server-only).
# NEXT_PUBLIC_API_URL=http://localhost:8000
